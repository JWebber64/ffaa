{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/league-history/import.js": {
      "maxDuration": 300,
      "includeFiles": "api/league-history/.generated/import.js"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/ff/",
      "permanent": false
    },
    {
      "source": "/ff",
      "destination": "/ff/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ff/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/ff/api/league-history/import",
      "destination": "/api/league-history/import"
    },
    {
      "source": "/ff/sleeper-api/:path*",
      "destination": "https://api.sleeper.app/v1/:path*"
    },
    {
      "source": "/ff/ffc-api/:path*",
      "destination": "https://fantasyfootballcalculator.com/api/v1/:path*"
    },
    {
      "source": "/ffc-api/:path*",
      "destination": "https://fantasyfootballcalculator.com/api/v1/:path*"
    },
    {
      "source": "/ff/favicon-32.png",
      "destination": "/favicon-32.png"
    },
    {
      "source": "/ff/icon-180.png",
      "destination": "/icon-180.png"
    },
    {
      "source": "/ff/icon-192.png",
      "destination": "/icon-192.png"
    },
    {
      "source": "/ff/icon-512.png",
      "destination": "/icon-512.png"
    },
    {
      "source": "/ff/site.webmanifest",
      "destination": "/site.webmanifest"
    },
    {
      "source": "/ff/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/ff/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/ff/sounds/:path*",
      "destination": "/sounds/:path*"
    },
    {
      "source": "/ff/data/:path*",
      "destination": "/data/:path*"
    },
    {
      "source": "/ff/teams/:path*",
      "destination": "/teams/:path*"
    },
    {
      "source": "/ff/",
      "destination": "/index.html"
    },
    {
      "source": "/ff/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}

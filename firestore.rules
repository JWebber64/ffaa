rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function permanentUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Connected fantasy teams follow a permanent GameHQ account across
    // devices. The profile stores only public Sleeper identifiers and cached
    // display context; it never grants lineup or commissioner permissions.
    match /fantasyManagerProfiles/{userId} {
      function validProfile() {
        return request.resource.data.keys().hasOnly([
            'version',
            'user_id',
            'active_league_id',
            'connections_json',
            'updated_at'
          ])
          && request.resource.data.version == 1
          && request.resource.data.user_id == userId
          && request.resource.data.active_league_id is string
          && request.resource.data.active_league_id.size() <= 32
          && request.resource.data.connections_json is string
          && request.resource.data.connections_json.size() <= 100000
          && request.resource.data.updated_at == request.time;
      }

      allow get: if permanentUser() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if permanentUser()
        && request.auth.uid == userId
        && validProfile();
      allow delete: if permanentUser() && request.auth.uid == userId;
    }

    // Permanent league history is public read-only data. Imports run through a
    // separately authorized server or one-time migration rule, never the app.
    match /leagueHistories/{historyId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // GameHQ league identity and role state is written only by authenticated
    // server commands. Browser clients may resolve a route and read the parts
    // of the workspace that apply to their own signed-in account.
    match /externalLeagueMappings/{mappingId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    match /nativeDraftShares/{shareToken} {
      allow get: if shareToken.size() >= 20 && shareToken.size() <= 80;
      allow list, create, update, delete: if false;
    }

    match /leagues/{leagueId} {
      function canonicalMembershipPath(userId) {
        return /databases/$(database)/documents/leagues/$(leagueId)/memberships/$(userId);
      }

      function isCanonicalMember() {
        return permanentUser()
          && exists(canonicalMembershipPath(request.auth.uid))
          && get(canonicalMembershipPath(request.auth.uid)).data.status == 'active';
      }

      function canonicalRoleGrantPath(grantId) {
        return /databases/$(database)/documents/leagues/$(leagueId)/roleGrants/$(grantId);
      }

      function hasCurrentCanonicalRole(grantId, role) {
        return exists(canonicalRoleGrantPath(grantId))
          && get(canonicalRoleGrantPath(grantId)).data.user_id == request.auth.uid
          && get(canonicalRoleGrantPath(grantId)).data.role == role
          && (!('revoked_at' in get(canonicalRoleGrantPath(grantId)).data)
            || get(canonicalRoleGrantPath(grantId)).data.revoked_at == '')
          && (!('expires_at' in get(canonicalRoleGrantPath(grantId)).data)
            || get(canonicalRoleGrantPath(grantId)).data.expires_at == '');
      }

      function isCanonicalManager() {
        return isCanonicalMember()
          && (hasCurrentCanonicalRole(request.auth.uid + '__commissioner', 'commissioner')
            || hasCurrentCanonicalRole(request.auth.uid + '__co_commissioner', 'co_commissioner'));
      }

      allow get: if signedIn();
      allow list, create, update, delete: if false;

      match /seasons/{seasonId} {
        allow get: if signedIn();
        allow list, create, update, delete: if false;

        match /seasonTeams/{seasonTeamId} {
          allow get, list: if signedIn();
          allow create, update, delete: if false;
        }

        match /rosterTransactions/{transactionId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /assetLocks/{assetLockId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /drafts/{draftId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /lineupWeeks/{weekId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /lineups/{lineupId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /scoringWeeks/{weekId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /scoringEvents/{eventId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }

        match /scoringEventRevisions/{revisionId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }

        match /waiverState/{stateId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /playerStates/{playerId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /waiverTeamStates/{franchiseId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        // Pending alternatives and bids are private to their submitting manager
        // and commissioners. Completed public outcomes use waiverReceipts.
        match /waiverClaims/{claimId} {
          allow get, list: if isCanonicalManager()
            || (isCanonicalMember() && resource.data.actor_user_id == request.auth.uid);
          allow create, update, delete: if false;
        }

        match /waiverRuns/{runId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }

        match /waiverReceipts/{receiptId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        // Active offers and immutable completed receipts are visible to league
        // members. Every mutation is performed by the authenticated command
        // service so asset reservations and two-team transfers stay atomic.
        match /tradeOffers/{offerId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /tradeReceipts/{receiptId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /tradeAssetLocks/{lockId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }

        match /draftPickStates/{assetId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /tradeableAssets/{assetId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        // The published competition graph is readable by every active league
        // member. Immutable versions and correction history remain
        // commissioner-only; all writes go through the command service.
        match /schedule/{scheduleId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /scheduleVersions/{versionId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }

        match /standings/{standingId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /matchupResults/{resultId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /matchupResultRevisions/{revisionId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }

        match /playoffBrackets/{bracketId} {
          allow get, list: if isCanonicalMember();
          allow create, update, delete: if false;
        }

        match /playoffBracketVersions/{versionId} {
          allow get, list: if isCanonicalManager();
          allow create, update, delete: if false;
        }
      }

      match /franchises/{franchiseId} {
        allow get, list: if signedIn();
        allow create, update, delete: if false;
      }

      match /settingsVersions/{settingsVersionId} {
        allow get: if signedIn();
        allow list: if isCanonicalMember();
        allow create, update, delete: if false;
      }

      match /externalConnections/{connectionId} {
        allow get: if signedIn();
        allow list, create, update, delete: if false;
      }

      match /memberships/{userId} {
        allow get: if permanentUser() && (request.auth.uid == userId || isCanonicalManager());
        allow list: if isCanonicalManager();
        allow create, update, delete: if false;
      }

      match /roleGrants/{grantId} {
        allow get: if permanentUser()
          && (resource.data.user_id == request.auth.uid || isCanonicalManager());
        allow list: if isCanonicalManager();
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow get, list: if isCanonicalManager();
        allow create, update, delete: if false;
      }

      match /commands/{commandId} {
        allow get: if permanentUser()
          && resource.data.actor_user_id == request.auth.uid;
        allow list, create, update, delete: if false;
      }

      match /auditEvents/{eventId} {
        allow get, list: if isCanonicalMember();
        allow create, update, delete: if false;
      }

      match /auditPrivate/{eventId} {
        allow get, list: if isCanonicalManager();
        allow create, update, delete: if false;
      }

      match /notificationOutbox/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /readModelInvalidations/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /lineups/{lineupId} {
        allow get, list: if isCanonicalMember();
        allow create, update, delete: if false;
      }
    }

    // Draft-order audit records stay private to their creator. A public replay
    // is copied into a separate, unguessable token document below.
    match /draftOrderDraws/{drawId} {
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.created_by == request.auth.uid;
      allow update: if signedIn()
        && resource.data.created_by == request.auth.uid
        && request.resource.data.created_by == request.auth.uid;
    }

    match /draftOrderShares/{shareToken} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && shareToken.size() >= 24
        && request.resource.data.created_by == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.created_by == request.auth.uid;
      // Replay tokens are immutable: an owner may revoke one, but never
      // replace the result behind an already-shared URL.
      allow update: if false;
    }

    // Offline drafts use an unguessable document id as their view link. Anyone
    // with that exact link may read it, but only its creating browser session
    // may change the teams, settings, bids, or rosters.
    match /offlineDrafts/{offlineDraftId} {
      function validOfflineDraftShape() {
        return request.resource.data.keys().hasOnly([
            'owner_user_id',
            'schema_version',
            'state',
            'league_id',
            'league_name',
            'season',
            'created_at',
            'updated_at',
            'version'
          ])
          && request.resource.data.keys().hasAll([
            'owner_user_id',
            'schema_version',
            'state',
            'created_at',
            'updated_at',
            'version'
          ])
          && request.resource.data.owner_user_id is string
          && request.resource.data.schema_version == 1
          && request.resource.data.state is map
          && request.resource.data.state.keys().hasAll(['teams', 'config', 'lastAssignment'])
          && request.resource.data.state.teams is list
          && request.resource.data.state.teams.size() >= 2
          && request.resource.data.state.teams.size() <= 32
          && request.resource.data.state.config is map
          && request.resource.data.created_at is string
          && request.resource.data.updated_at is string
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && (
            !request.resource.data.keys().hasAny(['league_id'])
            || request.resource.data.league_id is string
          )
          && (
            !request.resource.data.keys().hasAny(['league_name'])
            || request.resource.data.league_name is string
          )
          && (
            !request.resource.data.keys().hasAny(['season'])
            || request.resource.data.season is string
          );
      }

      allow get: if offlineDraftId.size() >= 20 && offlineDraftId.size() <= 80;
      allow list: if false;
      allow create: if signedIn()
        && offlineDraftId.size() >= 20
        && offlineDraftId.size() <= 80
        && validOfflineDraftShape()
        && request.resource.data.owner_user_id == request.auth.uid;
      allow update: if signedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state',
          'updated_at',
          'version'
        ])
        && validOfflineDraftShape();
      allow delete: if signedIn()
        && resource.data.owner_user_id == request.auth.uid;
    }

    // The active league id is the rendezvous point for an automatic second-
    // screen view. The first browser with an active draft is the only editor;
    // other signed-in browsers may read that league's board but cannot write it.
    match /offlineLeagueDrafts/{leagueId} {
      function validOfflineLeagueDraftShape() {
        return request.resource.data.keys().hasOnly([
            'owner_user_id',
            'schema_version',
            'league_id',
            'state',
            'created_at',
            'updated_at',
            'version'
          ])
          && request.resource.data.keys().hasAll([
            'owner_user_id',
            'schema_version',
            'league_id',
            'state',
            'created_at',
            'updated_at',
            'version'
          ])
          && request.resource.data.owner_user_id is string
          && request.resource.data.schema_version == 1
          && request.resource.data.league_id == leagueId
          && request.resource.data.state is map
          && request.resource.data.state.keys().hasOnly(['teams', 'config', 'lastAssignment'])
          && request.resource.data.state.keys().hasAll(['teams', 'config', 'lastAssignment'])
          && request.resource.data.state.teams is list
          && request.resource.data.state.teams.size() >= 2
          && request.resource.data.state.teams.size() <= 32
          && request.resource.data.state.config is map
          && request.resource.data.created_at is string
          && request.resource.data.updated_at is string
          && request.resource.data.version is int
          && request.resource.data.version >= 1;
      }

      allow get: if signedIn()
        && leagueId.matches('^[0-9]{10,}$');
      allow list: if false;
      allow create: if signedIn()
        && leagueId.matches('^[0-9]{10,}$')
        && validOfflineLeagueDraftShape()
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.version == 1;
      allow update: if signedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state',
          'updated_at',
          'version'
        ])
        && validOfflineLeagueDraftShape();
      allow delete: if signedIn()
        && resource.data.owner_user_id == request.auth.uid;
    }

    match /leagueSeasons/{leagueId} {
      function seasonPath() {
        return /databases/$(database)/documents/leagueSeasons/$(leagueId);
      }

      function savedDraftPath() {
        return /databases/$(database)/documents/offlineLeagueDrafts/$(leagueId);
      }

      function claimPath(franchiseId) {
        return /databases/$(database)/documents/leagueSeasons/$(leagueId)/franchiseClaims/$(franchiseId);
      }

      function membershipPath(userId) {
        return /databases/$(database)/documents/leagueSeasons/$(leagueId)/managerMemberships/$(userId);
      }

      function weekSettingsPath(weekKey) {
        return /databases/$(database)/documents/leagueSeasons/$(leagueId)/weekSettings/$(weekKey);
      }

      function auditEventPath(eventId) {
        return /databases/$(database)/documents/leagueSeasons/$(leagueId)/auditEvents/$(eventId);
      }

      function lineupPath(lineupId) {
        return /databases/$(database)/documents/leagueSeasons/$(leagueId)/lineups/$(lineupId);
      }

      function isCommissioner() {
        return permanentUser()
          && exists(seasonPath())
          && get(seasonPath()).data.commissioner_user_id == request.auth.uid;
      }

      function currentSeasonHasFranchise(franchiseId) {
        return exists(seasonPath())
          && get(seasonPath()).data.franchise_ids is list
          && get(seasonPath()).data.franchise_ids.hasAny([franchiseId]);
      }

      function controlsFranchise(franchiseId) {
        return permanentUser()
          && currentSeasonHasFranchise(franchiseId)
          && exists(claimPath(franchiseId))
          && get(claimPath(franchiseId)).data.status == 'approved'
          && get(claimPath(franchiseId)).data.approved_user_id == request.auth.uid;
      }

      function validSeasonDocument() {
        return request.resource.data.keys().hasOnly([
            'version',
            'league_id',
            'commissioner_user_id',
            'source_draft_revision',
            'payload',
            'schedule',
            'franchise_ids',
            'revision',
            'created_at',
            'published_at',
            'updated_at'
          ])
          && request.resource.data.league_id == leagueId
          && request.resource.data.commissioner_user_id == request.auth.uid
          && request.resource.data.payload is map
          && request.resource.data.schedule is list
          && request.resource.data.franchise_ids is list
          && request.resource.data.franchise_ids.size() >= 2
          && request.resource.data.franchise_ids.size() <= 16
          && request.resource.data.source_draft_revision is int
          && request.resource.data.revision is int;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if permanentUser()
        && exists(savedDraftPath())
        && get(savedDraftPath()).data.owner_user_id == request.auth.uid
        && validSeasonDocument();
      allow update: if isCommissioner()
        && validSeasonDocument()
        && request.resource.data.league_id == resource.data.league_id
        && request.resource.data.commissioner_user_id == resource.data.commissioner_user_id
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.revision > resource.data.revision;
      allow delete: if isCommissioner();

      match /franchiseClaims/{franchiseId} {
        function matchingMembershipAfter() {
          let membership = getAfter(membershipPath(request.resource.data.requested_by_user_id)).data;
          return existsAfter(membershipPath(request.resource.data.requested_by_user_id))
            && membership.league_id == leagueId
            && membership.user_id == request.resource.data.requested_by_user_id
            && membership.franchise_id == franchiseId
            && membership.franchise_name == request.resource.data.franchise_name
            && membership.display_name == request.resource.data.requested_display_name
            && membership.status == request.resource.data.status;
        }

        function validClaimBase() {
          return request.resource.data.keys().hasOnly([
              'league_id',
              'franchise_id',
              'franchise_name',
              'requested_by_user_id',
              'requested_display_name',
              'status',
              'approved_user_id',
              'requested_at',
              'approved_at',
              'updated_at'
            ])
            && request.resource.data.league_id == leagueId
            && request.resource.data.franchise_id == franchiseId
            && request.resource.data.franchise_name is string
            && request.resource.data.franchise_name.size() > 0
            && request.resource.data.franchise_name.size() <= 100
            && request.resource.data.requested_by_user_id is string
            && request.resource.data.requested_display_name is string
            && request.resource.data.requested_display_name.size() >= 2
            && request.resource.data.requested_display_name.size() <= 50;
        }

        allow read: if signedIn();
        allow create: if permanentUser()
          && currentSeasonHasFranchise(franchiseId)
          && validClaimBase()
          && matchingMembershipAfter()
          && (
            (
              request.resource.data.requested_by_user_id == request.auth.uid
              && request.resource.data.status == 'requested'
              && request.resource.data.approved_user_id == ''
              && request.resource.data.approved_at == ''
            )
            || (
              isCommissioner()
              && request.resource.data.requested_by_user_id == request.auth.uid
              && request.resource.data.status == 'approved'
              && request.resource.data.approved_user_id == request.auth.uid
            )
          );
        allow update: if isCommissioner()
          && validClaimBase()
          && currentSeasonHasFranchise(franchiseId)
          && matchingMembershipAfter()
          && resource.data.status == 'requested'
          && request.resource.data.status == 'approved'
          && request.resource.data.approved_user_id == resource.data.requested_by_user_id
          && request.resource.data.league_id == resource.data.league_id
          && request.resource.data.franchise_id == resource.data.franchise_id
          && request.resource.data.franchise_name == resource.data.franchise_name
          && request.resource.data.requested_by_user_id == resource.data.requested_by_user_id
          && request.resource.data.requested_display_name == resource.data.requested_display_name
          && request.resource.data.requested_at == resource.data.requested_at;
        allow delete: if !existsAfter(membershipPath(resource.data.requested_by_user_id))
          && (isCommissioner()
          || (
            permanentUser()
            && (
              resource.data.requested_by_user_id == request.auth.uid
              || resource.data.approved_user_id == request.auth.uid
            )
          ));
      }

      match /managerMemberships/{userId} {
        function matchingClaimAfter() {
          let claim = getAfter(claimPath(request.resource.data.franchise_id)).data;
          return existsAfter(claimPath(request.resource.data.franchise_id))
            && claim.league_id == leagueId
            && claim.franchise_id == request.resource.data.franchise_id
            && claim.requested_by_user_id == userId
            && claim.franchise_name == request.resource.data.franchise_name
            && claim.requested_display_name == request.resource.data.display_name
            && claim.status == request.resource.data.status;
        }

        function validMembership() {
          return request.resource.data.keys().hasOnly([
              'league_id',
              'user_id',
              'franchise_id',
              'franchise_name',
              'display_name',
              'status',
              'requested_at',
              'approved_at',
              'updated_at'
            ])
            && request.resource.data.league_id == leagueId
            && request.resource.data.user_id == userId
            && request.resource.data.franchise_id is string
            && currentSeasonHasFranchise(request.resource.data.franchise_id)
            && request.resource.data.franchise_name is string
            && request.resource.data.franchise_name.size() > 0
            && request.resource.data.franchise_name.size() <= 100
            && request.resource.data.display_name is string
            && request.resource.data.display_name.size() >= 2
            && request.resource.data.display_name.size() <= 50
            && (request.resource.data.status == 'requested' || request.resource.data.status == 'approved');
        }

        allow read: if permanentUser() && (userId == request.auth.uid || isCommissioner());
        allow create: if permanentUser()
          && validMembership()
          && matchingClaimAfter()
          && (
            (userId == request.auth.uid && request.resource.data.status == 'requested')
            || (isCommissioner() && request.resource.data.status == 'approved')
          );
        allow update: if isCommissioner()
          && validMembership()
          && matchingClaimAfter()
          && resource.data.status == 'requested'
          && request.resource.data.status == 'approved'
          && request.resource.data.league_id == resource.data.league_id
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.franchise_id == resource.data.franchise_id
          && request.resource.data.franchise_name == resource.data.franchise_name
          && request.resource.data.display_name == resource.data.display_name
          && request.resource.data.requested_at == resource.data.requested_at;
        allow delete: if !existsAfter(claimPath(resource.data.franchise_id))
          && (isCommissioner() || (permanentUser() && userId == request.auth.uid));
      }

      match /weekSettings/{settingsId} {
        function validWeekSettings() {
          return request.resource.data.keys().hasOnly([
              'league_id',
              'week',
              'week_key',
              'locked',
              'updated_by_user_id',
              'created_at',
              'updated_at'
            ])
            && request.resource.data.league_id == leagueId
            && request.resource.data.week is int
            && request.resource.data.week >= 1
            && request.resource.data.week <= 18
            && request.resource.data.week_key == settingsId
            && request.resource.data.locked is bool
            && request.resource.data.updated_by_user_id == request.auth.uid;
        }

        allow read: if signedIn();
        allow create: if isCommissioner() && validWeekSettings();
        allow update: if isCommissioner()
          && validWeekSettings()
          && request.resource.data.league_id == resource.data.league_id
          && request.resource.data.week == resource.data.week
          && request.resource.data.week_key == resource.data.week_key
          && request.resource.data.created_at == resource.data.created_at;
        allow delete: if isCommissioner();
      }

      match /lineups/{lineupId} {
        function weekKeyMatchesWeek(week, weekKey) {
          return (week == 1 && weekKey == 'week-1')
            || (week == 2 && weekKey == 'week-2')
            || (week == 3 && weekKey == 'week-3')
            || (week == 4 && weekKey == 'week-4')
            || (week == 5 && weekKey == 'week-5')
            || (week == 6 && weekKey == 'week-6')
            || (week == 7 && weekKey == 'week-7')
            || (week == 8 && weekKey == 'week-8')
            || (week == 9 && weekKey == 'week-9')
            || (week == 10 && weekKey == 'week-10')
            || (week == 11 && weekKey == 'week-11')
            || (week == 12 && weekKey == 'week-12')
            || (week == 13 && weekKey == 'week-13')
            || (week == 14 && weekKey == 'week-14')
            || (week == 15 && weekKey == 'week-15')
            || (week == 16 && weekKey == 'week-16')
            || (week == 17 && weekKey == 'week-17')
            || (week == 18 && weekKey == 'week-18');
        }

        function lineupIsOpen(weekKey) {
          return !exists(weekSettingsPath(weekKey))
            || get(weekSettingsPath(weekKey)).data.locked == false;
        }

        function matchingAuditAfter() {
          let audit = getAfter(auditEventPath(request.resource.data.audit_event_id)).data;
          return existsAfter(auditEventPath(request.resource.data.audit_event_id))
            && audit.lineup_id == lineupId
            && audit.actor_user_id == request.auth.uid
            && audit.franchise_id == request.resource.data.franchise_id
            && audit.week == request.resource.data.week
            && audit.season_revision == request.resource.data.season_revision
            && audit.after_assignments == request.resource.data.assignments;
        }

        function validLineupDocument() {
          return request.resource.data.keys().hasOnly([
              'league_id',
              'franchise_id',
              'week',
              'week_key',
              'season_revision',
              'assignments',
              'revision',
              'audit_event_id',
              'updated_by_user_id',
              'created_at',
              'updated_at'
            ])
            && request.resource.data.league_id == leagueId
            && request.resource.data.franchise_id is string
            && request.resource.data.week is int
            && request.resource.data.week >= 1
            && request.resource.data.week <= 18
            && request.resource.data.week_key is string
            && weekKeyMatchesWeek(request.resource.data.week, request.resource.data.week_key)
            && request.resource.data.season_revision == get(seasonPath()).data.revision
            && currentSeasonHasFranchise(request.resource.data.franchise_id)
            && request.resource.data.assignments is map
            && request.resource.data.assignments.size() <= 30
            && request.resource.data.revision is int
            && request.resource.data.audit_event_id is string
            && request.resource.data.audit_event_id.size() >= 10
            && request.resource.data.updated_by_user_id == request.auth.uid;
        }

        allow read: if signedIn();
        allow create, update, delete: if false;
      }

      match /auditEvents/{eventId} {
        function auditLineupIsOpen(weekKey) {
          return !exists(weekSettingsPath(weekKey))
            || get(weekSettingsPath(weekKey)).data.locked == false;
        }

        function validAuditEvent() {
          let lineup = getAfter(lineupPath(request.resource.data.lineup_id)).data;
          return request.resource.data.keys().hasOnly([
              'league_id',
              'event_id',
              'lineup_id',
              'type',
              'actor_user_id',
              'franchise_id',
              'week',
              'week_key',
              'season_revision',
              'before_assignments',
              'after_assignments',
              'reason',
              'created_at'
            ])
            && request.resource.data.league_id == leagueId
            && request.resource.data.event_id == eventId
            && request.resource.data.actor_user_id == request.auth.uid
            && request.resource.data.franchise_id is string
            && currentSeasonHasFranchise(request.resource.data.franchise_id)
            && request.resource.data.week is int
            && request.resource.data.week >= 1
            && request.resource.data.week <= 18
            && request.resource.data.week_key is string
            && request.resource.data.season_revision == get(seasonPath()).data.revision
            && request.resource.data.before_assignments is map
            && request.resource.data.before_assignments.size() <= 30
            && request.resource.data.after_assignments is map
            && request.resource.data.after_assignments.size() <= 30
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 240
            && existsAfter(lineupPath(request.resource.data.lineup_id))
            && lineup.audit_event_id == eventId
            && lineup.franchise_id == request.resource.data.franchise_id
            && lineup.week == request.resource.data.week
            && lineup.season_revision == request.resource.data.season_revision
            && lineup.assignments == request.resource.data.after_assignments
            && (
              (
                request.resource.data.type == 'lineup_saved'
                && auditLineupIsOpen(request.resource.data.week_key)
              )
              || (
                request.resource.data.type == 'lineup_override'
                && isCommissioner()
                && !auditLineupIsOpen(request.resource.data.week_key)
                && request.resource.data.reason.size() >= 4
              )
            );
        }

        allow read: if isCommissioner()
          || (permanentUser() && controlsFranchise(resource.data.franchise_id));
        allow create, update, delete: if false;
      }
    }

    match /drafts/{draftId} {
      function draftPath() {
        return /databases/$(database)/documents/drafts/$(draftId);
      }

      function draftDoc() {
        return get(draftPath());
      }

      function participantPath() {
        return /databases/$(database)/documents/drafts/$(draftId)/participants/$(request.auth.uid);
      }

      function participantDoc() {
        return get(participantPath());
      }

      function isParticipant() {
        return signedIn() && exists(participantPath());
      }

      function participantTeamId() {
        return participantDoc().data.team_id;
      }

      function isDraftHost() {
        return signedIn() && draftDoc().data.host_user_id == request.auth.uid;
      }

      function validParticipantSelfUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly([
            'display_name',
            'is_ready',
            'team_id',
            'team_number',
            'updated_at'
          ])
          && request.resource.data.user_id == resource.data.user_id
          && (
            !changed.hasAny(['team_id', 'team_number'])
            || draftDoc().data.snapshot.phase == 'lobby'
          );
      }

      function validAuctionStateKeys() {
        return request.resource.data.keys().hasOnly([
            'actionId',
            'bidWindowExpiresAt',
            'call',
            'currentBid',
            'highBidderTeamId',
            'playerId',
            'timerExpiresAt',
            'updatedAt',
            'version'
          ])
          && request.resource.data.keys().hasAll([
            'actionId',
            'bidWindowExpiresAt',
            'call',
            'currentBid',
            'highBidderTeamId',
            'playerId',
            'timerExpiresAt',
            'updatedAt',
            'version'
          ]);
      }

      function validParticipantAuctionStateBid(previousBid, previousHighBidderTeamId) {
        return isParticipant()
          && validAuctionStateKeys()
          && draftDoc().data.snapshot.phase == 'bidding'
          && draftDoc().data.snapshot.auction is map
          && request.resource.data.playerId == draftDoc().data.snapshot.auction.player.playerId
          && participantTeamId() is string
          && request.resource.data.highBidderTeamId == participantTeamId()
          && previousHighBidderTeamId != participantTeamId()
          && request.resource.data.currentBid is number
          && request.resource.data.currentBid > previousBid
          && request.resource.data.timerExpiresAt is string
          && request.resource.data.bidWindowExpiresAt is string
          && request.resource.data.call == 'none'
          && request.resource.data.actionId is string
          && request.resource.data.updatedAt is string
          && request.resource.data.version is number
          && request.resource.data.version > 0;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host_user_id == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.host_user_id == request.auth.uid;

      match /participants/{participantId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && participantId == request.auth.uid
          && request.resource.data.user_id == request.auth.uid;
        allow update: if signedIn()
          && participantId == request.auth.uid
          && resource.data.user_id == request.auth.uid
          && validParticipantSelfUpdate();
        allow delete: if signedIn()
          && participantId == request.auth.uid
          && resource.data.user_id == request.auth.uid;
      }

      match /actions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.draft_id == draftId;
        allow update, delete: if false;
      }

      match /auctionState/{stateId} {
        allow read: if signedIn();
        allow create: if stateId == 'current'
          && (
            isDraftHost()
            || validParticipantAuctionStateBid(
              draftDoc().data.snapshot.auction.currentBid,
              draftDoc().data.snapshot.auction.highBidderTeamId
            )
          );
        allow update: if stateId == 'current'
          && (
            isDraftHost()
            || validParticipantAuctionStateBid(
              resource.data.playerId == draftDoc().data.snapshot.auction.player.playerId
                ? resource.data.currentBid
                : draftDoc().data.snapshot.auction.currentBid,
              resource.data.playerId == draftDoc().data.snapshot.auction.player.playerId
                ? resource.data.highBidderTeamId
                : draftDoc().data.snapshot.auction.highBidderTeamId
            )
          );
        allow delete: if stateId == 'current' && isDraftHost();
      }
    }
  }
}

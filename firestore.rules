rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Permanent league history is public read-only data. Imports run through a
    // separately authorized server or one-time migration rule, never the app.
    match /leagueHistories/{historyId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Draft-order audit records stay private to their creator. A public replay
    // is copied into a separate, unguessable token document below.
    match /draftOrderDraws/{drawId} {
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.created_by == request.auth.uid;
      allow update: if signedIn()
        && resource.data.created_by == request.auth.uid
        && request.resource.data.created_by == request.auth.uid;
    }

    match /draftOrderShares/{shareToken} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && shareToken.size() >= 24
        && request.resource.data.created_by == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.created_by == request.auth.uid;
      // Replay tokens are immutable: an owner may revoke one, but never
      // replace the result behind an already-shared URL.
      allow update: if false;
    }

    // Offline drafts use an unguessable document id as their view link. Anyone
    // with that exact link may read it, but only its creating browser session
    // may change the teams, settings, bids, or rosters.
    match /offlineDrafts/{offlineDraftId} {
      function validOfflineDraftShape() {
        return request.resource.data.keys().hasOnly([
            'owner_user_id',
            'schema_version',
            'state',
            'league_id',
            'league_name',
            'season',
            'created_at',
            'updated_at',
            'version'
          ])
          && request.resource.data.keys().hasAll([
            'owner_user_id',
            'schema_version',
            'state',
            'created_at',
            'updated_at',
            'version'
          ])
          && request.resource.data.owner_user_id is string
          && request.resource.data.schema_version == 1
          && request.resource.data.state is map
          && request.resource.data.state.keys().hasAll(['teams', 'config', 'lastAssignment'])
          && request.resource.data.state.teams is list
          && request.resource.data.state.teams.size() >= 2
          && request.resource.data.state.teams.size() <= 32
          && request.resource.data.state.config is map
          && request.resource.data.created_at is string
          && request.resource.data.updated_at is string
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && (
            !request.resource.data.keys().hasAny(['league_id'])
            || request.resource.data.league_id is string
          )
          && (
            !request.resource.data.keys().hasAny(['league_name'])
            || request.resource.data.league_name is string
          )
          && (
            !request.resource.data.keys().hasAny(['season'])
            || request.resource.data.season is string
          );
      }

      allow get: if offlineDraftId.size() >= 20 && offlineDraftId.size() <= 80;
      allow list: if false;
      allow create: if signedIn()
        && offlineDraftId.size() >= 20
        && offlineDraftId.size() <= 80
        && validOfflineDraftShape()
        && request.resource.data.owner_user_id == request.auth.uid;
      allow update: if signedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'state',
          'updated_at',
          'version'
        ])
        && validOfflineDraftShape();
      allow delete: if signedIn()
        && resource.data.owner_user_id == request.auth.uid;
    }

    match /drafts/{draftId} {
      function draftPath() {
        return /databases/$(database)/documents/drafts/$(draftId);
      }

      function draftDoc() {
        return get(draftPath());
      }

      function participantPath() {
        return /databases/$(database)/documents/drafts/$(draftId)/participants/$(request.auth.uid);
      }

      function participantDoc() {
        return get(participantPath());
      }

      function isParticipant() {
        return signedIn() && exists(participantPath());
      }

      function participantTeamId() {
        return participantDoc().data.team_id;
      }

      function isDraftHost() {
        return signedIn() && draftDoc().data.host_user_id == request.auth.uid;
      }

      function validParticipantSelfUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly([
            'display_name',
            'is_ready',
            'team_id',
            'team_number',
            'updated_at'
          ])
          && request.resource.data.user_id == resource.data.user_id
          && (
            !changed.hasAny(['team_id', 'team_number'])
            || draftDoc().data.snapshot.phase == 'lobby'
          );
      }

      function validAuctionStateKeys() {
        return request.resource.data.keys().hasOnly([
            'actionId',
            'bidWindowExpiresAt',
            'call',
            'currentBid',
            'highBidderTeamId',
            'playerId',
            'timerExpiresAt',
            'updatedAt',
            'version'
          ])
          && request.resource.data.keys().hasAll([
            'actionId',
            'bidWindowExpiresAt',
            'call',
            'currentBid',
            'highBidderTeamId',
            'playerId',
            'timerExpiresAt',
            'updatedAt',
            'version'
          ]);
      }

      function validParticipantAuctionStateBid(previousBid, previousHighBidderTeamId) {
        return isParticipant()
          && validAuctionStateKeys()
          && draftDoc().data.snapshot.phase == 'bidding'
          && draftDoc().data.snapshot.auction is map
          && request.resource.data.playerId == draftDoc().data.snapshot.auction.player.playerId
          && participantTeamId() is string
          && request.resource.data.highBidderTeamId == participantTeamId()
          && previousHighBidderTeamId != participantTeamId()
          && request.resource.data.currentBid is number
          && request.resource.data.currentBid > previousBid
          && request.resource.data.timerExpiresAt is string
          && request.resource.data.bidWindowExpiresAt is string
          && request.resource.data.call == 'none'
          && request.resource.data.actionId is string
          && request.resource.data.updatedAt is string
          && request.resource.data.version is number
          && request.resource.data.version > 0;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host_user_id == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.host_user_id == request.auth.uid;

      match /participants/{participantId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && participantId == request.auth.uid
          && request.resource.data.user_id == request.auth.uid;
        allow update: if signedIn()
          && participantId == request.auth.uid
          && resource.data.user_id == request.auth.uid
          && validParticipantSelfUpdate();
        allow delete: if signedIn()
          && participantId == request.auth.uid
          && resource.data.user_id == request.auth.uid;
      }

      match /actions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.draft_id == draftId;
        allow update, delete: if false;
      }

      match /auctionState/{stateId} {
        allow read: if signedIn();
        allow create: if stateId == 'current'
          && (
            isDraftHost()
            || validParticipantAuctionStateBid(
              draftDoc().data.snapshot.auction.currentBid,
              draftDoc().data.snapshot.auction.highBidderTeamId
            )
          );
        allow update: if stateId == 'current'
          && (
            isDraftHost()
            || validParticipantAuctionStateBid(
              resource.data.playerId == draftDoc().data.snapshot.auction.player.playerId
                ? resource.data.currentBid
                : draftDoc().data.snapshot.auction.currentBid,
              resource.data.playerId == draftDoc().data.snapshot.auction.player.playerId
                ? resource.data.highBidderTeamId
                : draftDoc().data.snapshot.auction.highBidderTeamId
            )
          );
        allow delete: if stateId == 'current' && isDraftHost();
      }
    }
  }
}
